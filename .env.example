# Copy to .env.local (development) or set in your hosting dashboard (production), then redeploy.
# NEXT_PUBLIC_* values are inlined at build time.

# REQUIRED for ordering to work. International or local format, e.g. 2547XXXXXXXX or 07XXXXXXXX.
# Without a real number the order form shows "ordering unavailable" instead of sending to a wrong number.
NEXT_PUBLIC_PHARMACY_WHATSAPP=

# Optional business details. Anything left blank is hidden from the site (or highlighted as a
# "[…]" field on the legal pages so you can see what still needs completing).
NEXT_PUBLIC_PHARMACY_PHONE=
NEXT_PUBLIC_PHARMACY_EMAIL=
NEXT_PUBLIC_PHARMACY_ADDRESS=
NEXT_PUBLIC_PHARMACY_LEGAL_NAME=
NEXT_PUBLIC_PHARMACY_PPB_LICENCE=
NEXT_PUBLIC_PHARMACY_PHARMACIST=
NEXT_PUBLIC_PHARMACY_ODPC_REGISTRATION=

# Public site URL (canonical links, sitemap, social previews). On Vercel this is detected automatically.
NEXT_PUBLIC_SITE_URL=

# Set to "false" to remove Vercel Analytics and the analytics consent banner entirely.
NEXT_PUBLIC_ANALYTICS_ENABLED=true
